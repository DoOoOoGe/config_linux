input {
    mouse {
        accel-speed -0.8
        accel-profile "adaptive"
    }
    touchpad {
        tap
        accel-speed 0.2
        accel-profile "adaptive"
        natural-scroll
        dwt
        middle-emulation
        scroll-factor 0.6
        drag-lock
    }
    keyboard {
        repeat-delay 250
    }
}
