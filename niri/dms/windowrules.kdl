// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1789550363197297302 @name=org.gnome.Calculator
window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
}

// @id=wr_1791265322058569773 @name=pdf
window-rule {
    match app-id="^pdf$"
    scroll-factor 1.20
}

// @id=wr_1792823337069292433 @name=ToDesk
window-rule {
    match app-id="^ToDesk$" title="^ToDesk$"
    open-floating false
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
