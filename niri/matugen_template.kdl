layout {
  focus-ring {
    active-gradient from="#E075EFCC" to="#7575EFCC" angle=45 in="oklch shorter hue"
    inactive-color "#4e4e8e"
  }

  border {
    active-gradient from="#E075EFCC" to="#7575EFCC" angle=45 in="oklch shorter hue"
    inactive-color "#4e4e8e"
  }

  shadow {
    color "#716F75CC"
  }
}
